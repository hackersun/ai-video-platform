# Copy to a protected environment file. Never commit real values.
IMAGE_TAG=replace-with-git-sha
POSTGRES_DB=ai_video_platform
POSTGRES_USER=ai_video
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://ai_video:URL_ENCODED_PASSWORD@postgres:5432/ai_video_platform
REDIS_PASSWORD=replace-with-a-long-random-password
REDIS_URL=redis://:URL_ENCODED_PASSWORD@redis:6379/0
FERNET_KEY=replace-with-python-cryptography-fernet-key
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
OBJECT_STORAGE_PROVIDER=qiniu
AUTH_EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
AUTH_EMAIL_FROM=no-reply@example.com
PUBLIC_APP_URL=https://app.example.com
CUSTOMER_BILLING_MODE=enforced
OPERATIONS_TOKEN=replace-with-a-long-random-operations-token
NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
# 国内网络可按企业供应链策略改为受信任的 npm 镜像。
NPM_REGISTRY=https://registry.npmjs.org
HTTP_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
