{
  "name": "ai-video-platform-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test e2e/smoke.spec.ts --project=chromium",
    "e2e:production-os": "node ../scripts/run-isolated-frontend-e2e.mjs e2e/production-os-frontend-acceptance.spec.ts --project=chromium --workers=1",
    "e2e:production-os:direct": "playwright test e2e/production-os-frontend-acceptance.spec.ts --project=chromium --workers=1",
    "e2e:production-os:real": "node ../scripts/run-isolated-production-os.mjs",
    "e2e:production-os:real:direct": "playwright test e2e/production-os-frontend-acceptance.spec.ts --project=chromium --workers=1",
    "e2e:four-chapter:direct": "playwright test e2e/four-chapter-series-run.spec.ts --project=chromium --workers=1",
    "e2e:four-chapter:live:direct": "playwright test e2e/four-chapter-live-canary.spec.ts --project=chromium --workers=1",
    "verify:production-os:static": "npm run typecheck && NEXT_DIST_DIR=.next-verify npm run build",
    "e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "d3": "^7.8.5",
    "lucide-react": "^0.344.0",
    "next": "14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.0"
  }
}
