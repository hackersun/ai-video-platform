{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next-playwright/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-four-chapter-verify/types/**/*.ts",
    ".next-playwright-four-chapter-1876071f-5183-4f4f-8be3-82f673b676af/types/**/*.ts",
    ".next-playwright-four-chapter-70da3bf6-cddb-48e4-972e-56a1fc1a5e11/types/**/*.ts",
    ".next-playwright-four-chapter-90fd54aa-03b7-49af-9af9-41d4f6bf8d44/types/**/*.ts",
    ".next-playwright-four-chapter-97df348d-d5d9-4801-bdc8-c915b33cb451/types/**/*.ts",
    ".next-playwright-four-chapter-1f4e1bab-bfad-4183-a2aa-1d2d05c0e315/types/**/*.ts",
    ".next-playwright-live-evidence/types/**/*.ts",
    ".next-playwright-four-chapter-063fbf11-631d-4635-b85e-2326bca0f767/types/**/*.ts",
    ".next-playwright-four-chapter-cb46a276-0cc0-49a0-8011-9fd02b50ddf6/types/**/*.ts",
    ".next-verify/dev/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-playwright/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
