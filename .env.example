# AI视频平台开发环境配置
# 复制此文件为.env并修改配置

# ============================================
# 数据库配置
# ============================================
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/aivideo
REDIS_URL=redis://redis:6379/0

# ============================================
# Milvus向量数据库配置
# ============================================
MILVUS_HOST=milvus
MILVUS_PORT=19530

# ============================================
# Neo4j图数据库配置
# ============================================
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ============================================
# MinIO对象存储配置
# ============================================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=aivideo

# ============================================
# JWT认证配置
# ============================================
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================
# 环境配置
# ============================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ============================================
# 前端配置
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_NAME=AI视频平台

# ============================================
# AI服务配置（免费模型优先）
# ============================================

# 图像生成提供商: local, midjourney, dalle3, stability
IMAGE_PROVIDER=local
# 本地模型路径
LOCAL_SD_MODEL_PATH=/app/models/stable-diffusion-xl

# 视频生成提供商: local, runway, pika
VIDEO_PROVIDER=local
# 本地视频模型路径
LOCAL_SVD_MODEL_PATH=/app/models/stable-video-diffusion

# 语音合成提供商: edge, elevenlabs, azure
# 强烈推荐Edge TTS（完全免费）
TTS_PROVIDER=edge
# Edge TTS语音选择
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# 音乐生成提供商: local, suno, udio
MUSIC_PROVIDER=local

# 大语言模型提供商: local, openai, anthropic
LLM_PROVIDER=local
# OpenAI配置（可选）
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4

# ============================================
# Celery任务队列配置
# ============================================
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_WORKER_CONCURRENCY=2

# ============================================
# 邮件配置（可选）
# ============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ============================================
# 第三方登录配置（可选）
# ============================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================
# 监控配置
# ============================================
ENABLE_METRICS=true
METRICS_PORT=9090
