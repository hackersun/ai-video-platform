{
  "name": "ai-video-platform",
  "version": "1.0.0",
  "description": "## 项目概述",
  "main": "test-frontend-direct.js",
  "scripts": {
    "test": "npm run verify:quick",
    "verify:backend": "cd backend && python -m pytest",
    "verify:frontend": "npm --prefix frontend run typecheck && npm --prefix frontend run build",
    "verify:e2e": "npm --prefix frontend run e2e:smoke",
    "verify:e2e:legacy": "npm --prefix e2e test",
    "verify:live:anime": "npm --prefix frontend run e2e -- live-anime-production-seedance.spec.ts --project=chromium --workers=1",
    "verify:quick": "npm run verify:frontend && npm run verify:e2e",
    "audit:artifacts": "cd backend && PYTHONPATH=. python3 scripts/audit_generated_artifacts.py --root .."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "playwright": "^1.58.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  }
}
