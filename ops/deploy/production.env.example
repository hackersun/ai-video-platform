# Copy to ~/ai-video-platform/shared/production.env and replace every CHANGE_ME value.
APP_HTTP_PORT=8080
API_WORKERS=2
AI_VIDEO_DATA_ROOT=/srv/ai-video-platform/data
AI_VIDEO_RUNTIME_ROOT=/srv/ai-video-platform/runtime
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
JWT_SECRET_KEY=CHANGE_ME_RANDOM_JWT_SECRET
FERNET_KEY=CHANGE_ME_VALID_FERNET_KEY

# Optional provider credentials. They remain server-side and may be configured later in the UI.
VOLCENGINE_API_KEY=
OPENAI_API_KEY=

# G4 private media storage. Production refuses STORAGE_PROVIDER=local unless
# ALLOW_LOCAL_STORAGE_IN_PRODUCTION=1. Bucket MUST be private (no public-read).
# Signed URLs are issued at response time after owner authorization.
MEDIA_SIGNING_KEY=CHANGE_ME_RANDOM_MEDIA_SIGNING_KEY
STORAGE_PROVIDER=s3
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=0
STORAGE_BUCKET_ACL=private
STORAGE_KEY_PREFIX=avp
STORAGE_SIGNED_URL_TTL_SECONDS=900
# S3-compatible (AWS S3 / MinIO / Cloudflare R2 / 腾讯云 COS / 阿里云 OSS S3 API)
S3_ENDPOINT_URL=https://s3.CHANGE_ME_REGION.amazonaws.com
S3_REGION=CHANGE_ME_REGION
S3_BUCKET=CHANGE_ME_PRIVATE_BUCKET
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true
# 七牛 Kodo private bucket (STORAGE_PROVIDER=qiniu); QINIU_DOMAIN = bucket's bound (private) domain
QINIU_BUCKET=
QINIU_DOMAIN=
QINIU_UPLOAD_URL=https://upload.qiniup.com
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
